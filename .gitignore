# Türkçe sesler (H-083): ödenmiş ham önbellek (Alania WAV, Duyu, Sarah parçaları) ve eski ElevenLabs yedeği
icerik/**/_raw/

# Kitaplık (H-066): ses ve görsel kaynakları git dışında; hizalama (audio/*.align.json) depoda.
# Aylık TTS karakter defteri (kitaplar/_maliyet/) depoda tutulur.
kitaplar/**/images/
kitaplar/**/*.png
kitaplar/**/*.jpg
kitaplar/**/*.jpeg
kitaplar/**/*.webp
kitaplar/**/*.mp3
kitaplar/**/*.m4a
kitaplar/**/audio/_parts/
kitaplar/**/_build/

# Dilbilgisi dersleri (H-077): ses git dışında; hizalamalar (audio/**/*.align.json) ve
# audio/lesson-audio.json depoda. Ödenmiş ham önbellek ve paket git dışında.
dilbilgisi/**/*.mp3
dilbilgisi/**/*.m4a
dilbilgisi/**/audio/**/_raw/
dilbilgisi/**/_build/

# Bağımsız reeller (H-094): `reel.json` (senaryo, altyazı, hedef) depoda; görsel ve
# ses kaynakları, ödenmiş ham önbellek ve paket çıktısı git dışında.
reeller/**/stills/
reeller/**/*.png
reeller/**/*.jpg
reeller/**/*.jpeg
reeller/**/*.webp
reeller/**/*.mp3
reeller/**/*.m4a
reeller/**/_raw/
reeller/**/_build/

