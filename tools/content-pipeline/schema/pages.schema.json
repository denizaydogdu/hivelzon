{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hi.velzon.tr/schema/pages.v1.schema.json",
  "title": "hiVelzon Kitaplık sayfa ve zamanlama dosyası (_build/package/pages.json)",
  "description": "Sayfa → cümle → kelime. Zamanlar saniyedir ve cümlenin bölüm sesinin (chapters[].audio) başına görelidir; ElevenLabs karakter hizalamasından gelir (align.sentence_timings) ve anlatım temposu uygulandıysa işlenmiş sese göre yeniden hesaplanır (pacing.py, H-069). Hizalama yoksa start/end null'dur (sessiz okuma). Bölüm altyazısı biçiminin (subs.schema.json) kitap karşılığı. H-066.",
  "type": "object",
  "required": ["schemaVersion", "bookId", "contentVersion", "level", "chapters", "pages"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "bookId": { "type": "string", "pattern": "^(A1|A2|B1|B2|C1|C2)-K[0-9]{2}$" },
    "contentVersion": { "type": "integer", "minimum": 1 },
    "level": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "audio", "duration", "heading", "pages"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^c[0-9]{1,2}$" },
          "title": { "type": "string", "minLength": 1 },
          "audio": { "type": ["string", "null"] },
          "duration": { "type": ["number", "null"], "minimum": 0 },
          "heading": { "description": "Seslendirilen bölüm başlığı (sesin ilk cümlesi).", "$ref": "#/$defs/sentence" },
          "pages": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "number", "chapter", "image", "sentences"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^p[0-9]{2,3}$" },
          "number": { "type": "integer", "minimum": 1 },
          "chapter": { "type": "string" },
          "image": { "description": "images/<sayfa>.webp ya da resimsiz sayfada null (palet rengiyle çizilir).", "type": ["string", "null"] },
          "sentences": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sentence" } }
        }
      }
    }
  },
  "$defs": {
    "time": { "type": ["number", "null"], "minimum": 0 },
    "sentence": {
      "type": "object",
      "required": ["id", "paragraph", "text", "start", "end", "tr", "words", "chunks"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "paragraph": { "description": "Sayfadaki paragraf sırası (1'den); bölüm başlığında 0.", "type": "integer", "minimum": 0 },
        "text": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/time" },
        "end": { "$ref": "#/$defs/time" },
        "tr": { "description": "Türkçe cümle (ceviri.tr.json). Çeviri yoksa null.", "type": ["string", "null"] },
        "words": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["w", "start", "end", "gloss"],
            "additionalProperties": false,
            "properties": {
              "w": { "type": "string" },
              "start": { "$ref": "#/$defs/time" },
              "end": { "$ref": "#/$defs/time" },
              "gloss": { "description": "Kelimenin bu cümledeki Türkçe anlamı; özel adda ya da çeviri yoksa null.", "type": ["string", "null"] }
            }
          }
        },
        "chunks": {
          "description": "Kalıp ifadeler: words dizisinde startWord..endWord (ikisi de dahil, 0 tabanlı).",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["en", "tr", "startWord", "endWord"],
            "additionalProperties": false,
            "properties": {
              "en": { "type": "string", "minLength": 1 },
              "tr": { "type": "string", "minLength": 1 },
              "startWord": { "type": "integer", "minimum": 0 },
              "endWord": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
